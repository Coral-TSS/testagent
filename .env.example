# Copy to .env and adjust. .env is git-ignored: never commit real passwords or keys.
# The same file serves Docker Compose (variable substitution) and local development
# (read by the platform at startup, prefix TESTAGENT_).

# ---- Docker Compose ----------------------------------------------------------------
# Password of the bundled PostgreSQL (only reachable inside the compose network).
POSTGRES_PASSWORD=change-me
# Host port of the web UI (bound to 127.0.0.1).
# TESTAGENT_PORT=8765
# Seed the procurement demo SUT on first start (1 = yes, 0 = no).
# TESTAGENT_SEED_DEMO=1
# Seeded demo bugs on (1) or off (0).
# PROCUREMENT_DEMO_BUGS=1
# Use another Debian mirror while building the image, if deb.debian.org is unreachable.
# DEBIAN_MIRROR=deb.debian.org

# ---- Platform (Docker and local) ----------------------------------------------------
# Fixed sign-in token. If empty, a random token is generated on every start and the
# sign-in link is printed to the log ("[TestAgent] Sign in: http://localhost:8765/#t=...").
# TESTAGENT_ACCESS_TOKEN=
# Extra Host names accepted besides localhost, comma separated (e.g. a LAN host name).
# TESTAGENT_ALLOWED_HOSTS=
# Time zone for schedules and displayed times (IANA name).
# TESTAGENT_TIMEZONE=UTC
# Language of the text the agent writes (requirements, cases, reports).
# TESTAGENT_AGENT_LANGUAGE=English

# ---- Local development only (ignored by Docker Compose) -----------------------------
# TESTAGENT_DATABASE_URL=postgresql://testagent:<password>@127.0.0.1:5432/testagent
# Separate database used only by the test suite (it is wiped by tests).
# TESTAGENT_TEST_DATABASE_URL=postgresql://testagent:<password>@127.0.0.1:5432/testagent_test
# TESTAGENT_RUNTIME_DIR=./runtime

# The model (OpenAI-compatible endpoint, model name, API key) is configured in the UI
# under "Agent settings"; the API key is stored in runtime/secrets.json, never in the database.
