# Copy to .env and adjust. .env is git-ignored: never commit real passwords or keys.
# The same file serves Docker Compose (variable substitution) and local development
# (read by the platform at startup, prefix TESTAGENT_).

# ---- Docker Compose ----------------------------------------------------------------
# Password of the bundled PostgreSQL (only reachable inside the compose network).
POSTGRES_PASSWORD=change-me
# Host port of the web UI (bound to 127.0.0.1).
# TESTAGENT_PORT=8765
# Seed the procurement demo SUT on first start (1 = yes, 0 = no).
# TESTAGENT_SEED_DEMO=1
# Seeded demo bugs on (1) or off (0).
# PROCUREMENT_DEMO_BUGS=1

# ---- Package mirrors for building the image (optional) -----------------------------
# Empty = official sources. Set them when downloads are slow, e.g. on a server in mainland China
# (Aliyun values shown). Packages are still checked against the hashes in the lock files.
# Debian mirror host (apt-get, Chromium system libraries).
# DEBIAN_MIRROR=mirrors.aliyun.com
# Python package index (uv / pip).
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# npm registry for the web UI.
# NPM_REGISTRY=https://registry.npmmirror.com
# Download host for Playwright's Chromium build.
# PLAYWRIGHT_DOWNLOAD_HOST=https://cdn.npmmirror.com/binaries/playwright
# Image that provides the uv binary (only if ghcr.io is unreachable; use a registry proxy you trust).
# UV_IMAGE=ghcr.io/astral-sh/uv:0.13

# ---- Public HTTPS (Docker, optional) -------------------------------------------------
# Start the Caddy proxy on port 443 as well (leave unset for local-only use).
# COMPOSE_PROFILES=public
# The server's public IP address (no domain needed), e.g. 203.0.113.10.
# TESTAGENT_PUBLIC_HOST=
# Certificate: acme = Let's Encrypt IP certificate (6-day, renewed automatically; port 443 must be
# reachable from the internet), internal = Caddy's own CA (browser warning; fallback).
# TESTAGENT_TLS=acme

# ---- Accounts (Docker and local) ----------------------------------------------------
# First admin, created on start only while there are no accounts yet. Choose your own values
# (password: at least 10 characters). After the first sign-in you can remove the password here.
# TESTAGENT_ADMIN_USER=
# TESTAGENT_ADMIN_PASSWORD=
# Sessions end after this many idle hours, and at the latest after this many days.
# TESTAGENT_SESSION_IDLE_HOURS=12
# TESTAGENT_SESSION_MAX_DAYS=7

# ---- Platform (Docker and local) ----------------------------------------------------
# Extra Host names accepted besides localhost and TESTAGENT_PUBLIC_HOST, comma separated
# (e.g. a LAN host name).
# TESTAGENT_ALLOWED_HOSTS=
# Time zone for schedules and displayed times (IANA name).
# TESTAGENT_TIMEZONE=UTC
# Language of the text the agent writes (requirements, cases, reports).
# TESTAGENT_AGENT_LANGUAGE=English

# ---- Local development only (ignored by Docker Compose) -----------------------------
# TESTAGENT_DATABASE_URL=postgresql://testagent:<password>@127.0.0.1:5432/testagent
# Separate database used only by the test suite (it is wiped by tests).
# TESTAGENT_TEST_DATABASE_URL=postgresql://testagent:<password>@127.0.0.1:5432/testagent_test
# TESTAGENT_RUNTIME_DIR=./runtime

# The model (OpenAI-compatible endpoint, model name, API key) is configured in the UI
# under "Agent settings"; the API key is stored in runtime/secrets.json, never in the database.
